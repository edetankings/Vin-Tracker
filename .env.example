# Keep these pointed at your EXISTING Supabase project.
VITE_SUPABASE_URL=https://your-existing-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-existing-public-key
SUPABASE_URL=https://your-existing-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-existing-public-key
# Server only; required only for trusted admin operations. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Google OAuth Client ID/Secret are configured in the Supabase dashboard.
# Never put the Google Client Secret in a VITE_ variable.
# Allow this app's /auth/callback URL in Supabase Authentication URL Configuration.
